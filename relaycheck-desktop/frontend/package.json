{
  "name": "relaycheck-desktop-ui",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "node scripts/verify-navigation.mjs",
    "smoke:schedules": "node scripts/verify-site-schedules-layout.mjs",
    "smoke:layout": "node scripts/verify-layout-alpha.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tailwindcss/vite": "4.3.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "8.46.0",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "playwright": "1.61.1",
    "prettier": "3.7.4",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9.3",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}
